# Copy this file to .env and fill in real values. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=true

# Two-process split: the public listings app and the admin app run as separate
# processes on separate ports (each behind its own gunicorn in production).
PUBLIC_PORT=5000
ADMIN_PORT=5001
# Used by the admin app to render "view on public site" links across the port
# boundary. In production set this to the public HTTPS domain (e.g.
# https://gangpiao-anjia.com).
PUBLIC_SITE_URL=http://localhost:5000

# Database (SQLite file path, relative to project root)
DATABASE_PATH=instance/data.db

# Initial admin account created by seed.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-run

# Image storage
# Set to "local" during development; set to "s3" for Lightsail Object Storage in production.
STORAGE_BACKEND=local

# Local mode (development): files are saved to static/uploads/ and served by Flask.
LOCAL_UPLOAD_DIR=static/uploads
LOCAL_UPLOAD_URL_PREFIX=/static/uploads

# S3 / Lightsail Object Storage (production)
# Get these from Lightsail console: Object Storage > Manage access keys
S3_BUCKET=hk-expats-rent
S3_REGION=ap-southeast-1
S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=https://hk-expats-rent.s3.ap-southeast-1.amazonaws.com
